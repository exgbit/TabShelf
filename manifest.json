{
  "manifest_version": 3,
  "name": "TabShelf - 标签收藏集",
  "version": "0.1.0",
  "description": "免费开源的 Toby 替代品：保存/恢复标签组、新标签页工作台、全局搜索。数据纯本地，支持导出导入。",
  "permissions": ["tabs", "storage", "favicon"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "chrome_url_overrides": {
    "newtab": "newtab.html"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
